filters:
  and:
    - file.inFolder("Books")
properties:
  note.read:
    displayName: read
views:
  - type: cool-bases
    name: Shelf
    order:
      - genre
      - file.name
      - author
      - rating
      - year
      - read
    sort:
      - property: year
        direction: DESC
    coolbases:
      card:
        w: 320
        fill: true
        fmt: libre
        h: 150
        pad: 5
        radius: 4
        gap: 14
      col:
        bg: "#181818"
        grad: false
        bg2: "#2b2b2b"
        angle: 180
        text: "#f0f0f0"
        det: "#f2c94c"
        bw: 0
        bc: "#ffffff29"
      font:
        family: Georgia
        weight: 400
        size: 3.8
        align: left
      img:
        src: auto
        pos: left
        fit: original
        frame: 5
        fx: color
        amt:
          bn: 100
          duo: 100
          blur: 35
          inv: 100
        duo1: "#141414"
        duo2: "#e5332f"
        grain: false
        bright: 100
        shade: false
        shadeC: "#000000"
        empty: portada
        cvText: note.author
        cvColors: auto
        cvShape: auto
        cvFont: Georgia
      foot:
        on: false
        bg: "#00000000"
        lw: 1
        lc: "#ffffff1f"
        filled: false
      rate:
        on: true
        prop: note.rating
        type: stars
        place: entre
        onImg: false
        mx: 5
        my: 5
        color: det
        size: 4
        empty: true
        over: 5
        shape: bubble
        byVal: true
        fill: filled
      states:
        on: true
        list:
          - id: s00ggae1
            prop: note.read
            show: always
            yes: Read
            no: To read
            fmt: check
            icon: ✓
            frame: border
            bw: 1.5
            radius: 3
            pad: 0.6
            rot: -8
            color: det
            bg: "#00000000"
            font:
            upper: false
            size: 3
            weight: 500
            place: br
            onImg: false
            mx: 5
            my: 5
      lines:
        on: false
        n: 1
        color: det
        w: 2
        width: full
        pct: 30
        mt: 1.6
        mb: 1.6
      hover:
        on: true
        color: tx
        bg: "#ffffff"
        bgOp: 10
        under: true
      css: ""
      v: 1
      items:
        - id: dw9gunuq
          kind: dato
          prop: note.genre
          type: etiquetas
          font:
          upper: true
          color: det
          size: 2.6
          weight: 700
          fit: false
          spaceT: 0
          spaceB: 0.8
          ital: false
          under: false
          hl: false
          hlc: "#e5332f59"
          strike: false
          sup: false
          link: none
          hover: false
          before: ""
          after: ""
          hide: ""
          join: false
          sep: ·
          gap: 1
          t:
            multi: inline
            nfmt: full
            dec: 0
            src: manual
            short: true
            tagStyle: text
            max: 2
            tsep: " · "
            yes: Sí
            no: ""
            stStyle: pill
            show: value
            fixed: ""
            arrow: true
            sort: orig
            dir: desc
            nlay: lines
            head: ""
            headColor: "#8a8a8a"
            more: ""
        - id: df47vp1y
          kind: title
          prop: file.name
          type: texto
          font:
          upper: false
          color: tx
          size: 6.5
          weight: 700
          fit: false
          spaceT: 0.4
          spaceB: 0.4
          ital: false
          under: false
          hl: false
          hlc: "#e5332f59"
          strike: false
          sup: false
